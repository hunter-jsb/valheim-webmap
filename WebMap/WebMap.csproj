<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- One version, manifest.json's: the assembly carries it and ManifestVersion below
       hands it to the plugin, so a release bumps the manifest alone. -->
  <PropertyGroup>
    <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../manifest.json')), '"version_number"\s*:\s*"([0-9.]+)"').Groups[1].Value)</ManifestVersion>
    <Version>$(ManifestVersion)</Version>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>WebMap</AssemblyName>
    <AssemblyTitle>Valheim WebMap</AssemblyTitle>
    <Copyright>(c) 2025 Various Authors</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NuGetAudit>false</NuGetAudit>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <!-- the build has no warnings: one that appears is fixed, not let through -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"><PrivateAssets>all</PrivateAssets></PackageReference>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Publicize Include="assembly_valheim" />
    <Publicize Include="assembly_utils" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>..\libs\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>..\libs\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Harmony"><HintPath>..\libs\BepInEx\core\BepInEx.Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>..\libs\valheim\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>..\libs\valheim\assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Security"><HintPath>..\libs\valheim\Mono.Security.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>..\libs\valheim\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>..\libs\valheim\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>..\libs\valheim\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>..\libs\valheim\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SoftReferenceableAssets"><HintPath>..\libs\valheim\SoftReferenceableAssets.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Splatform"><HintPath>..\libs\valheim\Splatform.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="steamworks"><HintPath>..\libs\valheim\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WebsocketSharp"><HintPath>..\libs\websocket-sharp.dll</HintPath></Reference>
  </ItemGroup>

  <!-- BepInPlugin wants a constant, so the manifest's version is compiled in as one -->
  <Target Name="ManifestVersion" BeforeTargets="CoreCompile">
    <Error Condition="'$(ManifestVersion)' == ''" Text="manifest.json has no version_number" />
    <WriteLinesToFile File="$(IntermediateOutputPath)Manifest.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace WebMap { internal static class Manifest { public const string Version = &quot;$(ManifestVersion)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Manifest.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)Manifest.g.cs" />
    </ItemGroup>
  </Target>
</Project>
